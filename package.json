    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "serve": "^14.2.6",
    "vitest": "^4.1.11"
  }
}
