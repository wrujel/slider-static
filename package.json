{
  "name": "slider-static",
  "version": "1.0.0",
  "private": true,
  "description": "A sleek, animated image carousel/slider built with vanilla HTML, CSS, and JavaScript.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
